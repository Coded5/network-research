{
  "schema_version": "1.0",
  "name": "Free Space Propagation",
  "environment": {"width_m": 500, "height_m": 500},
  "transmitters": [
    {
      "id": "tx_1", "name": "Base station", "position": [100, 250, 10],
      "frequency_hz": 2400000000, "power_dbm": 20, "antenna_gain_dbi": 0
    }
  ],
  "receivers": [
    {"id": "rx_1", "name": "Near receiver", "position": [200, 250, 1.5], "sensitivity_dbm": -90},
    {"id": "rx_2", "name": "Far receiver", "position": [400, 250, 1.5], "sensitivity_dbm": -90}
  ],
  "propagation": {"model": "friis", "parameters": {"system_loss": 1}},
  "sampling": {"resolution_m": 5, "receiver_height_m": 1.5},
  "simulation": {"duration_s": 1, "seed": 42}
}
